# BetterForward Enhance 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 机器人Token (从 @BotFather 获取)
TOKEN=your_bot_token_here

# 群组ID (管理群组的数字ID)
GROUP_ID=your_group_id_here

# 语言设置 (en_US, zh_CN, ja_JP)
LANGUAGE=zh_CN

# Telegram API地址 (可选，默认为官方API)
# TG_API=https://api.telegram.org

# 工作线程数 (可选，默认为2)
# WORKERS=2

# 消息洪泛防护 (可选，以下为默认值)
# QUEUE_SIZE=1000
# GROUP_QUEUE_SIZE=200
# PER_USER_QUEUE_SIZE=5
# UNVERIFIED_RATE=0.1
# VERIFIED_RATE=0.1666666667
# PRIORITY_RATE=0.5
# PRIORITY_BURST=10
# PRIORITY_INACTIVITY_SECONDS=86400
# GLOBAL_RATE=10
# ABUSE_BLOCK_THRESHOLD=20
# ABUSE_BLOCK_SECONDS=3600

# 多实例共享限流 (可选；需要使用 requirements-redis.txt 构建镜像)
# REDIS_URL=redis://redis:6379/0
# REDIS_PREFIX=betterforward-enhance

# Telegram WebApp + Cloudflare Turnstile 首次启动默认值
# 保存过运行时配置后，以数据库中的设置为准
# WEBAPP_ENABLED=disable
# WEBAPP_PUBLIC_URL=https://verify.example.com/captcha
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=verify.example.com
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080
# WEBAPP_AUTH_MAX_AGE=300
